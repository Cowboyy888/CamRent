# Copy to .env.local and fill in values. Never commit .env.local.
# Full walkthrough: docs/supabase-setup.md

# Public base URL of the website, used for canonical and hreflang links and
# for the links in invitation / password-reset emails.
# Defaults to http://localhost:3000 when empty.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" key, or the newer "publishable" key (sb_publishable_...).
# Safe for the browser: Row Level Security protects the data.
# (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix with NEXT_PUBLIC_ and never commit. Bypasses Row
# Level Security. Used only to invite staff (src/server/auth/staff-invitations.ts).
# Use the "service_role" key, or the newer secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=
